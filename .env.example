# App config
APP_NAME=RiskOps
APP_ENV=development
DEBUG=false
SECRET_KEY=change-me
# SQLite only. Use a persistent writable directory for the database file.
DATABASE_URL=sqlite:///./backend/riskops.db
CORS_ORIGINS=http://localhost:3000
DEMO_API_TOKEN=replace-with-a-long-random-value

# Server-side Gemini configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash
LLM_TIMEOUT_SECONDS=30

# Risk settings
DEFAULT_BUDGET=500000
SIMULATION_ITERATIONS=10000

# frontend/.env.local contains only BACKEND_API_URL and DEMO_API_TOKEN.
# Use the same DEMO_API_TOKEN as above; see README for frontend setup.
