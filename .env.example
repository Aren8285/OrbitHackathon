# App config
APP_NAME=RiskOps
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me
# SQLite only. Use a persistent writable directory for the database file.
DATABASE_URL=sqlite:///./riskops.db
ALLOWED_ORIGINS=http://localhost:3000
DEMO_API_TOKEN=replace-with-a-long-random-value
BACKEND_API_URL=http://127.0.0.1:8000

# External APIs
EPSS_API_URL=https://api.first.org/data/v1/epss
KEV_API_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=
LLM_TIMEOUT_SECONDS=10

# Risk settings
DEFAULT_BUDGET=500000
SIMULATION_ITERATIONS=10000
